---

<Layout title="About | sopieizo.work">
	<main class="section-wrapper">
		<div class="left">
			<h1 class="title">Comission</h1>
		</div>
		<div class="right">
			<div class="section section1">
				<h2>このページは現在整備中です</h2>
				<p>ご依頼の相談やご連絡は、sopieizo@shiftz.workへ</p>
			</div>
		</div>
	</main>
</Layout>

<script>
	import animation from '@/scripts/animation';
	animation();
</script>